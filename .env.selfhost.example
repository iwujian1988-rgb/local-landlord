NODE_ENV=production
PORT=3000

DB_TYPE=mysql
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME
DB_DATABASE=local_landlord

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

WX_APPID=CHANGE_ME
WX_SECRET=CHANGE_ME

# Self-hosted deployments store uploads in the persistent Docker volume.
UPLOAD_MODE=local

ALLOW_OPENID_HEADER=false
BASE_URL=https://api.wulianzhijia.cn
PUBLIC_BASE_URL=https://api.wulianzhijia.cn
CORS_ORIGIN=https://api.wulianzhijia.cn
